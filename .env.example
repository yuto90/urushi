# Vertex AI / GCP。ADC は gcloud auth application-default login で設定し、キーはコミットしないでください。
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# vertex-gemini / vertex-claude / mock
URUSHI_PROVIDER=vertex-gemini

# 既定: vertex-gemini は gemini-4-neon、vertex-claude は claude-sonnet-5-5
URUSHI_MODEL=gemini-4-neon

# Web UI
PORT=3333

# Chromium を自動検出できない場合だけ指定
# URUSHI_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
