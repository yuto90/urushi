{
  "name": "urushi",
  "version": "0.1.0",
  "description": "型付きスキーマとVertex AIでスライドデッキを生成・検証・修正・書き出す基盤",
  "type": "module",
  "bin": {
    "urushi": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "npm run build --silent && node dist/cli.js",
    "sample": "npm run build --silent && node dist/cli.js generate \"サンプルデッキ\" --provider mock --out out/sample",
    "schema": "npm run build --silent && node dist/cli.js schema --out schema/deck.schema.json",
    "mcp": "npm run build --silent && node dist/cli.js mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "1.1.3",
    "@google/genai": "3.6.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "gsap": "3.15.1",
    "playwright-core": "1.65.1",
    "pptxgenjs": "4.0.1",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "image-size": "2.1.0"
  }
}
