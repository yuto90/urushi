{
  "name": "urushi",
  "version": "0.1.0",
  "description": "自然言語からリッチなHTMLスライドデッキを生成するプロトタイプ",
  "type": "module",
  "bin": {
    "urushi": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "npm run build --silent && node dist/cli.js",
    "sample": "npm run build --silent && node dist/cli.js --sample \"サンプルデッキ\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
