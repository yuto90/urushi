{
  "name": "urushi",
  "version": "0.1.0",
  "description": "型付きスキーマとVertex AIでスライドデッキを生成・検証・修正・書き出す基盤",
  "type": "module",
  "bin": {
    "urushi": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build && node dist/cli.js serve",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "vite build --mode pages",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit && tsc -p public/tsconfig.json",
    "cli": "npm run build --silent && node dist/cli.js",
    "sample": "npm run build --silent && node dist/cli.js generate \"サンプルデッキ\" --provider mock --out out/sample",
    "schema": "npm run build --silent && node dist/cli.js schema --out schema/deck.schema.json",
    "mcp": "npm run build --silent && node dist/cli.js mcp",
    "test": "npm run build --silent && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "1.1.3",
    "@google/genai": "3.6.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "jose": "6.2.18",
    "lucide-react": "1.83.0",
    "playwright-core": "1.65.1",
    "pptxgenjs": "4.0.1",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "image-size": "2.1.0"
  }
}
